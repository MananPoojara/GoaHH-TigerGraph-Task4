# Copy to .env and fill in. Never commit .env.

# --- TigerGraph -----------------------------------------------------------
# Savanna: https://<workspace>.i.tgcloud.io   CE: http://localhost:14240
TG_HOST=
TG_GRAPHNAME=FraudLens
# Supply either an API token or a username/password pair.
TG_API_TOKEN=
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_TGCLOUD=true
TG_MCP_TRANSPORT=stdio
TG_LOG_TOOL_CALLS=true
TG_TIMEOUT_SECONDS=30

# --- LLM ------------------------------------------------------------------
# gemini | openai | anthropic | none. With "none" the workflow still runs
# end to end using the deterministic fallback for planning and explanation.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=gemini-embedding-001

# --- GraphRAG retrieval ---------------------------------------------------
GRAPHRAG_CHUNK_SIZE=2048
GRAPHRAG_CHUNK_OVERLAP=256
GRAPHRAG_TOP_K=5
GRAPHRAG_NUM_HOPS=2

# --- Application ----------------------------------------------------------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- Reproducibility ------------------------------------------------------
DATASET_VERSION=hhgoa-ieee-2026-09-18
POLICY_VERSION=1.0
PROMPT_VERSION=1.0
SIMULATOR_SEED=20260923

# --- Safety ---------------------------------------------------------------
# Financial effects are simulated for this prototype.
SIMULATE_EXTERNAL_ACTIONS=true
# Leave false. The agent may execute `auto` actions only; L1/L2 wait for a
# named human approval, which is recorded in the audit trail.
ALLOW_NON_AUTO_ACTION_EXECUTION=false
BENCHMARK_MEMORY_MODE=chronological
