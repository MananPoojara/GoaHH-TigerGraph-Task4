# TigerGraph connection
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPHNAME=FraudLens
TG_API_TOKEN=
TG_TGCLOUD=true
TG_MCP_TRANSPORT=stdio
TG_LOG_TOOL_CALLS=true
TG_LOG_CALLER_IDENTITY=profile

# LLM provider (choose one provider during implementation)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=

# GraphRAG starting configuration; tune against the evaluation set
GRAPHRAG_CHUNKER=markdown
GRAPHRAG_CHUNK_SIZE=2048
GRAPHRAG_CHUNK_OVERLAP=256
GRAPHRAG_TOP_K=5
GRAPHRAG_NUM_HOPS=2

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Reproducibility
DATASET_VERSION=hhgoa-ieee-2026-09-18
POLICY_VERSION=1.0
PROMPT_VERSION=unimplemented

# Safety and benchmark controls
SIMULATE_EXTERNAL_ACTIONS=true
ALLOW_NON_AUTO_ACTION_EXECUTION=false
BENCHMARK_MEMORY_MODE=chronological
